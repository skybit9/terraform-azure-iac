# ── Environment: development ──────────────────────────────────────────────────────
# Copy to terraform.tfvars and fill in. Real tfvars files are gitignored.
# Never put secrets here: they come from Key Vault at pipeline runtime.

vm_name             = "vm-app-dev-001"
resource_group_name = "rg-app-dev"
location            = "canadacentral"
vm_size             = "Standard_B2s"
admin_username      = "azureadmin"
os_disk_size_gb     = 64
os_disk_type        = "StandardSSD_LRS"

# Supplied by the pipeline as TF_VAR_subnet_id and TF_VAR_key_vault_id,
# sourced from the networking and keyvault module outputs.
# subnet_id    = ""
# key_vault_id = ""

nsg_allowed_ssh_source = "10.10.0.0/16"

tags = {
  environment = "development"
  cost-center = "platform-engineering"
  owner       = "cloud-team"
  managed-by  = "terraform"
}
