# Terraform state: contains secrets in plaintext (including generated SSH keys)
*.tfstate
*.tfstate.*

# Provider and module cache
.terraform/

# NOTE: .terraform.lock.hcl is deliberately NOT ignored. Commit it, so every
# run and every engineer uses the exact provider builds that were reviewed.

# Saved plans and pipeline outputs
*.binary
tfplan.*
apply.*
applied-plan.txt
drift.txt
checkov.xml

# Local overrides only. The committed terraform.tfvars files hold no secrets.
*.auto.tfvars
*.local.tfvars
override.tf
override.tf.json
*_override.tf

# Bootstrap output: app IDs and service principal object IDs
bootstrap/identities.env

# Tooling
.venv/
crash.log
crash.*.log
.DS_Store
.idea/
.vscode/
