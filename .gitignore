# Terraform state: contains secrets in plaintext. Never commit.
*.tfstate
*.tfstate.*
*.tfstate.backup

# Provider binaries and lock dir
.terraform/
.terraform.lock.hcl

# tfvars in this repo hold no secrets (names, sizes, CIDRs, tags) and ARE
# committed so each stack is reproducible. Secrets come from Key Vault or
# remote state at runtime. Keep any local override file out:
*.auto.tfvars
*.local.tfvars

# Saved plans
*.tfplan
*.binary
plan-*.json
plan-*.txt
apply-*.txt

# Crash logs
crash.log
crash.*.log

# Editor / OS
.vscode/
.idea/
.DS_Store

# Bootstrap output: contains app IDs and SP object IDs
bootstrap/identities.env
